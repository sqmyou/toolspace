{
  "name": "toolspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fast, privacy-first developer tools that run entirely in your browser. No ads, no accounts, no servers.",
  "license": "MIT",
  "homepage": "https://toolspace.sirsamyoudev.workers.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/sqmyou/toolspace.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "wrangler": "^4.42.0"
  },
  "dependencies": {
    "sql-formatter": "^15.9.0"
  }
}
