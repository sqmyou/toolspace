/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https://i.ytimg.com https://avatars.githubusercontent.com; media-src 'self' blob:; font-src 'self'; connect-src 'self' https://i.ytimg.com https://dns.google https://api.github.com; worker-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()

# img-src allows blob: because the image tools decode a chosen file by handing
# an object URL to an <img>. Without it the browser refuses the load and every
# upload looks like a corrupt file. blob: is same-origin, in-memory and never
# leaves the tab, so this does not weaken the privacy promise.
#
# media-src allows blob: for the same reason: the GIF Maker decodes a chosen
# video through an object URL on a <video>. media-src is not covered by
# default-src in the directive list above, so without this the element has no
# permitted source at all. Same in-tab object URL, never a remote fetch.

# Network origins. toolspace is a static, serverless SPA, so a tool can only
# reach an API that serves `Access-Control-Allow-Origin`; the browser refuses
# the rest no matter what this policy says. Every origin here is a narrow,
# anonymous public lookup, is listed on the tool that uses it (`Tool.remote`)
# and in the README, is disabled by default when the user turns network tools
# off, and carries no cookies and no credentials:
#   i.ytimg.com            - YouTube thumbnail grabber (public images only)
#   dns.google             - DNS Lookup (the domain name you type)
#   api.github.com         - GitHub profile lookup (public profile data)
#   avatars.githubusercontent.com - the GitHub avatar image (img-src only)
# There is no proxy, no API key and no first-party server in front of any of
# them. Adding another origin means updating this list, the README and the
# home-page copy in the same change.

# Hashed assets are immutable; cache them hard. HTML is revalidated.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache
